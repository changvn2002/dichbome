# === Giải Mã Gia Đình (dichbome) — biến môi trường ===
# Copy file này thành `.env.local` rồi chỉnh giá trị. Không commit file .env.local.

# URL gốc của bản production — dùng làm metadataBase cho SEO (canonical,
# Open Graph, sitemap, robots). Không có slash cuối.
# Mặc định (khi không đặt): https://dichbome.vercel.app
# Khi gắn domain chính thức, đặt biến này trên Vercel/host rồi deploy lại.
NEXT_PUBLIC_SITE_URL=https://dichbome.vercel.app

# Chế độ gọi API của giao diện:
#   http (mặc định) — gọi các route handlers tích hợp sẵn trong chính repo này
#                     (app/api/products/dichbome/*) — engine phía server.
#   local           — không cần server: UI dùng thẳng engine rule-based trên
#                     máy trong components/dichbome/lib/translate.ts. Hai
#                     engine được một parity suite tự động kiểm chứng khớp
#                     nhau (xem README mục Development).
NEXT_PUBLIC_DICHBOME_API_MODE=http

# (Tuỳ chọn) Base URL của backend khi chạy chế độ http.
# Để trống = gọi API cùng origin của chính app Next này (khuyến nghị).
# Chỉ điền khi muốn trỏ sang một backend riêng tương thích contract
# POST /api/products/dichbome/translate + GET /api/products/dichbome/examples
# (ví dụ bản NestJS gốc của ChangtoTech).
NEXT_PUBLIC_API_URL=
